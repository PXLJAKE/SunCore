{
  "$defs": {
    "ComfortBand": {
      "additionalProperties": false,
      "description": "Allowed temperature range in °C.",
      "properties": {
        "max_c": {
          "maximum": 150,
          "minimum": -50,
          "title": "Max C",
          "type": "number"
        },
        "min_c": {
          "maximum": 150,
          "minimum": -50,
          "title": "Min C",
          "type": "number"
        }
      },
      "required": [
        "min_c",
        "max_c"
      ],
      "title": "ComfortBand",
      "type": "object"
    },
    "ControlKind": {
      "description": "How a device is driven.",
      "enum": [
        "on_off",
        "steps",
        "continuous",
        "setpoint",
        "mode"
      ],
      "title": "ControlKind",
      "type": "string"
    },
    "DeviceDefaults": {
      "additionalProperties": false,
      "description": "Defaults copied into a new :class:`~suncore.core.devices.DeviceConfig`.",
      "properties": {
        "comfort": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComfortBand"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "control": {
          "$ref": "#/$defs/ControlKind"
        },
        "max_switches_per_hour": {
          "anyOf": [
            {
              "maximum": 3600,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Switches Per Hour"
        },
        "min_pause_s": {
          "default": 0,
          "maximum": 86400,
          "minimum": 0,
          "title": "Min Pause S",
          "type": "integer"
        },
        "min_run_s": {
          "default": 0,
          "maximum": 86400,
          "minimum": 0,
          "title": "Min Run S",
          "type": "integer"
        },
        "power_model": {
          "$ref": "#/$defs/PowerModelDefault"
        }
      },
      "required": [
        "power_model",
        "control"
      ],
      "title": "DeviceDefaults",
      "type": "object"
    },
    "DeviceKind": {
      "description": "Kind of controllable device. Templates use climate, switch and number_load for now.",
      "enum": [
        "climate",
        "switch",
        "number_load",
        "water_heater",
        "heat_pump",
        "wallbox",
        "program",
        "generic"
      ],
      "title": "DeviceKind",
      "type": "string"
    },
    "EntityMatcher": {
      "additionalProperties": false,
      "description": "Role matcher; every given criterion must match, ``domain`` is mandatory.\n\n``units`` lists acceptable ``unit_of_measurement`` strings (exact, case-sensitive).",
      "properties": {
        "device_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Class"
        },
        "domain": {
          "pattern": "^[a-z_]+$",
          "title": "Domain",
          "type": "string"
        },
        "platform": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Platform"
        },
        "state_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State Class"
        },
        "translation_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Translation Key"
        },
        "units": {
          "anyOf": [
            {
              "items": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 8,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        }
      },
      "required": [
        "domain"
      ],
      "title": "EntityMatcher",
      "type": "object"
    },
    "PowerModelDefault": {
      "additionalProperties": false,
      "description": "Default power model; ``power_role``/``energy_role`` refer to roles of the template.",
      "properties": {
        "energy_role": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,31}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Energy Role"
        },
        "kind": {
          "$ref": "#/$defs/PowerModelKind"
        },
        "nominal_w": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1000000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nominal W"
        },
        "power_role": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,31}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Power Role"
        }
      },
      "required": [
        "kind"
      ],
      "title": "PowerModelDefault",
      "type": "object"
    },
    "PowerModelKind": {
      "description": "How a device's power is obtained (BRIEF §4.5); each kind yields an uncertain estimate.",
      "enum": [
        "measured",
        "counter_derived",
        "learned",
        "nominal"
      ],
      "title": "PowerModelKind",
      "type": "string"
    },
    "RoleSpec": {
      "additionalProperties": false,
      "description": "One entity role of a template.",
      "properties": {
        "description": {
          "maxLength": 120,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "title": "Description",
          "type": "string"
        },
        "matcher": {
          "$ref": "#/$defs/EntityMatcher"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "matcher",
        "description"
      ],
      "title": "RoleSpec",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Documentation a template (or one of its facts) is based on.",
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "maxLength": 500,
          "pattern": "^https?://\\S+$",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "title",
        "url",
        "date"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "TestedWith": {
      "additionalProperties": false,
      "description": "Integration version the template was verified against.",
      "properties": {
        "integration": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Integration",
          "type": "string"
        },
        "version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "integration",
        "version"
      ],
      "title": "TestedWith",
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/pxljake/suncore/main/templates/schema/device.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {
        "maxLength": 48,
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "maxItems": 32,
      "title": "Capabilities",
      "type": "array"
    },
    "defaults": {
      "$ref": "#/$defs/DeviceDefaults"
    },
    "device_kind": {
      "$ref": "#/$defs/DeviceKind"
    },
    "id": {
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "device",
      "title": "Kind",
      "type": "string"
    },
    "name": {
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "title": "Name",
      "type": "string"
    },
    "roles": {
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,31}$": {
          "$ref": "#/$defs/RoleSpec"
        }
      },
      "title": "Roles",
      "type": "object"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "minItems": 1,
      "title": "Source",
      "type": "array"
    },
    "tested_with": {
      "items": {
        "$ref": "#/$defs/TestedWith"
      },
      "title": "Tested With",
      "type": "array"
    },
    "unverified": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "title": "Unverified",
      "type": "array"
    }
  },
  "required": [
    "id",
    "schema_version",
    "name",
    "source",
    "tested_with",
    "capabilities",
    "kind",
    "device_kind",
    "roles",
    "defaults"
  ],
  "title": "DeviceTemplate",
  "type": "object"
}
