{
  "$defs": {
    "Capability": {
      "description": "What a template provides.",
      "enum": [
        "power_measured",
        "energy_counter",
        "on_off",
        "power_setpoint",
        "temperature_setpoint",
        "hvac_modes",
        "preset_modes",
        "fan_modes",
        "price_now",
        "price_curve",
        "pv_curve",
        "pv_quantiles",
        "feed_in_tiers",
        "negative_price_rule",
        "battery_soc",
        "min_soc_limit",
        "charge_limit",
        "discharge_limit",
        "grid_charge",
        "battery_modes",
        "hardware_fallback",
        "ev_charging",
        "phase_switching",
        "sg_ready",
        "remote_start",
        "export_limit",
        "ac_limit",
        "backup_state"
      ],
      "title": "Capability",
      "type": "string"
    },
    "EntityMatcher": {
      "additionalProperties": false,
      "description": "Role matcher; every given criterion must match, ``domain`` is mandatory.\n\n``units`` lists acceptable ``unit_of_measurement`` strings (exact, case-sensitive);\n``unit_pattern`` is a regular expression matched with ``re.fullmatch`` on the stripped\nunit. ``translation_key`` / ``translation_key_pattern`` likewise. Exact and pattern\nforms exclude each other.",
      "properties": {
        "device_class": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Class"
        },
        "domain": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Domain",
          "type": "string"
        },
        "platforms": {
          "anyOf": [
            {
              "items": {
                "maxLength": 48,
                "pattern": "^[a-z][a-z0-9_]*$",
                "type": "string"
              },
              "maxItems": 8,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Platforms"
        },
        "state_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State Class"
        },
        "translation_key": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Translation Key"
        },
        "translation_key_pattern": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Translation Key Pattern"
        },
        "unit_pattern": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Pattern"
        },
        "units": {
          "anyOf": [
            {
              "items": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 8,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        }
      },
      "required": [
        "domain"
      ],
      "title": "EntityMatcher",
      "type": "object"
    },
    "RoleSpec": {
      "additionalProperties": false,
      "description": "One entity role of a template.",
      "properties": {
        "description": {
          "maxLength": 120,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "title": "Description",
          "type": "string"
        },
        "matcher": {
          "$ref": "#/$defs/EntityMatcher"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "same_device_as": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,31}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Same Device As"
        }
      },
      "required": [
        "matcher",
        "description"
      ],
      "title": "RoleSpec",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Documentation a template (or one of its facts) is based on.",
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "maxLength": 500,
          "pattern": "^https?://\\S+$",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "title",
        "url",
        "date"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "TestedWith": {
      "additionalProperties": false,
      "description": "Integration version the template was verified against.",
      "properties": {
        "integration": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Integration",
          "type": "string"
        },
        "version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "integration",
        "version"
      ],
      "title": "TestedWith",
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/pxljake/suncore/main/templates/schema/inverter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Inverter limit adapter template (PR 6-G, ADR-0018 decision 3; kind ``inverter``).\n\nExactly one role, ``limit``: a ``number`` for ``generic_number`` and ``kostal_rest`` (it is\nwritten with ``number.set_value`` and read back), a ``modbus`` ``sensor`` for\n``kostal_modbus`` (read-back of the register that ``modbus.write_register`` writes).\n``limit_capability`` ``None`` = the configuration chooses (generic: W or %). ``min``/``max``\nbound the writable value in the capability's unit; ``volatile``: the value is lost on an\ninverter reset and is re-written while SunCore holds a limit. Writes go through the safety\ngate only (X1-X6, ``safety.inverter``).",
  "properties": {
    "capabilities": {
      "items": {
        "$ref": "#/$defs/Capability"
      },
      "maxItems": 32,
      "title": "Capabilities",
      "type": "array"
    },
    "default_pct": {
      "default": 100.0,
      "maximum": 100,
      "minimum": 1,
      "title": "Default Pct",
      "type": "number"
    },
    "driver": {
      "enum": [
        "generic_number",
        "kostal_rest",
        "kostal_modbus"
      ],
      "title": "Driver",
      "type": "string"
    },
    "id": {
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "inverter",
      "title": "Kind",
      "type": "string"
    },
    "limit_capability": {
      "anyOf": [
        {
          "enum": [
            "export_limit",
            "ac_limit"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Limit Capability"
    },
    "max": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max"
    },
    "min": {
      "default": 0.0,
      "minimum": 0,
      "title": "Min",
      "type": "number"
    },
    "min_app_version": {
      "anyOf": [
        {
          "pattern": "^\\d+(\\.\\d+)*((a|b|rc)\\d+)?(\\.post\\d+)?(\\.dev\\d+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Min App Version"
    },
    "modbus_register": {
      "anyOf": [
        {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Modbus Register"
    },
    "name": {
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "title": "Name",
      "type": "string"
    },
    "roles": {
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,31}$": {
          "$ref": "#/$defs/RoleSpec"
        }
      },
      "title": "Roles",
      "type": "object"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "settle_s": {
      "default": 10,
      "maximum": 600,
      "minimum": 0,
      "title": "Settle S",
      "type": "integer"
    },
    "source": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "minItems": 1,
      "title": "Source",
      "type": "array"
    },
    "tested_with": {
      "items": {
        "$ref": "#/$defs/TestedWith"
      },
      "title": "Tested With",
      "type": "array"
    },
    "unverified": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "title": "Unverified",
      "type": "array"
    },
    "volatile": {
      "default": false,
      "title": "Volatile",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "schema_version",
    "name",
    "source",
    "tested_with",
    "capabilities",
    "kind",
    "roles",
    "driver"
  ],
  "title": "InverterTemplate",
  "type": "object"
}
