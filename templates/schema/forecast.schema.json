{
  "$defs": {
    "ActionSeries": {
      "additionalProperties": false,
      "description": "Series returned by a read-only action (``return_response`` is implied).",
      "properties": {
        "domain": {
          "maxLength": 48,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Domain",
          "type": "string"
        },
        "end_field": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Field"
        },
        "fields": {
          "$ref": "#/$defs/SeriesFields"
        },
        "max_horizon_h": {
          "maximum": 336,
          "minimum": 1,
          "title": "Max Horizon H",
          "type": "integer"
        },
        "response_path": {
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_]+(\\.([A-Za-z0-9_]+|\\*))*$",
          "title": "Response Path",
          "type": "string"
        },
        "service": {
          "maxLength": 48,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Service",
          "type": "string"
        },
        "source": {
          "const": "action",
          "title": "Source",
          "type": "string"
        },
        "start_field": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Field"
        }
      },
      "required": [
        "source",
        "domain",
        "service",
        "response_path",
        "fields",
        "max_horizon_h"
      ],
      "title": "ActionSeries",
      "type": "object"
    },
    "AttributeSeries": {
      "additionalProperties": false,
      "description": "Series held in an attribute of the entities of ``roles`` (concatenated in order).\n\n``list_path`` (Phase 4, generic attribute adapter): dotted path from the attribute's\nvalue to the points when the attribute is a mapping (``None`` = the attribute itself\nholds the points). ``shape`` says what the points are:\n\n* ``list`` (default): a list of objects named by ``fields`` (Solcast\n  ``detailedForecast``);\n* ``mapping``: an object ``{iso_timestamp: value}`` (Forecast.Solar ``wh_hours``,\n  Open-Meteo Solar Forecast ``wh_period_15m``); ``fields`` then gives only\n  ``value_unit`` - no point field names and no quantiles.\n\nThe period length of a point is the template's ``resolution_min``.",
      "properties": {
        "attribute": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Attribute",
          "type": "string"
        },
        "fields": {
          "$ref": "#/$defs/SeriesFields"
        },
        "list_path": {
          "anyOf": [
            {
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "List Path"
        },
        "roles": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,31}$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Roles",
          "type": "array"
        },
        "shape": {
          "default": "list",
          "enum": [
            "list",
            "mapping"
          ],
          "title": "Shape",
          "type": "string"
        },
        "source": {
          "const": "attribute",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "roles",
        "attribute",
        "fields"
      ],
      "title": "AttributeSeries",
      "type": "object"
    },
    "Capability": {
      "description": "What a template provides.",
      "enum": [
        "power_measured",
        "energy_counter",
        "on_off",
        "power_setpoint",
        "temperature_setpoint",
        "hvac_modes",
        "preset_modes",
        "fan_modes",
        "price_now",
        "price_curve",
        "pv_curve",
        "pv_quantiles",
        "feed_in_tiers",
        "negative_price_rule",
        "battery_soc",
        "min_soc_limit",
        "charge_limit",
        "discharge_limit",
        "grid_charge",
        "battery_modes"
      ],
      "title": "Capability",
      "type": "string"
    },
    "EntityMatcher": {
      "additionalProperties": false,
      "description": "Role matcher; every given criterion must match, ``domain`` is mandatory.\n\n``units`` lists acceptable ``unit_of_measurement`` strings (exact, case-sensitive);\n``unit_pattern`` is a regular expression matched with ``re.fullmatch`` on the stripped\nunit. ``translation_key`` / ``translation_key_pattern`` likewise. Exact and pattern\nforms exclude each other.",
      "properties": {
        "device_class": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Class"
        },
        "domain": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Domain",
          "type": "string"
        },
        "platforms": {
          "anyOf": [
            {
              "items": {
                "maxLength": 48,
                "pattern": "^[a-z][a-z0-9_]*$",
                "type": "string"
              },
              "maxItems": 8,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Platforms"
        },
        "state_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State Class"
        },
        "translation_key": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Translation Key"
        },
        "translation_key_pattern": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Translation Key Pattern"
        },
        "unit_pattern": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Pattern"
        },
        "units": {
          "anyOf": [
            {
              "items": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 8,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        }
      },
      "required": [
        "domain"
      ],
      "title": "EntityMatcher",
      "type": "object"
    },
    "RoleSpec": {
      "additionalProperties": false,
      "description": "One entity role of a template.",
      "properties": {
        "description": {
          "maxLength": 120,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "title": "Description",
          "type": "string"
        },
        "matcher": {
          "$ref": "#/$defs/EntityMatcher"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "same_device_as": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,31}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Same Device As"
        }
      },
      "required": [
        "matcher",
        "description"
      ],
      "title": "RoleSpec",
      "type": "object"
    },
    "SeriesFields": {
      "additionalProperties": false,
      "description": "Names of the fields of one series point and the unit of its values.\n\n``timestamp_field`` and ``value_field`` are required for a list of point objects\n(``action`` series, ``attribute`` series of shape ``list``) and absent for an\n``attribute`` series of shape ``mapping``, whose keys are the timestamps and whose\nvalues are the values.",
      "properties": {
        "p10_field": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P10 Field"
        },
        "p90_field": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P90 Field"
        },
        "timestamp_field": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp Field"
        },
        "value_field": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Field"
        },
        "value_unit": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Value Unit",
          "type": "string"
        }
      },
      "required": [
        "value_unit"
      ],
      "title": "SeriesFields",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Documentation a template (or one of its facts) is based on.",
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "maxLength": 500,
          "pattern": "^https?://\\S+$",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "title",
        "url",
        "date"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "TestedWith": {
      "additionalProperties": false,
      "description": "Integration version the template was verified against.",
      "properties": {
        "integration": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Integration",
          "type": "string"
        },
        "version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "integration",
        "version"
      ],
      "title": "TestedWith",
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/pxljake/suncore/main/templates/schema/forecast.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {
        "$ref": "#/$defs/Capability"
      },
      "maxItems": 32,
      "title": "Capabilities",
      "type": "array"
    },
    "forecast_kind": {
      "enum": [
        "pv",
        "load"
      ],
      "title": "Forecast Kind",
      "type": "string"
    },
    "id": {
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "forecast",
      "title": "Kind",
      "type": "string"
    },
    "min_app_version": {
      "anyOf": [
        {
          "pattern": "^\\d+(\\.\\d+)*((a|b|rc)\\d+)?(\\.post\\d+)?(\\.dev\\d+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Min App Version"
    },
    "name": {
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "title": "Name",
      "type": "string"
    },
    "resolution_min": {
      "maximum": 1440,
      "minimum": 1,
      "title": "Resolution Min",
      "type": "integer"
    },
    "roles": {
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,31}$": {
          "$ref": "#/$defs/RoleSpec"
        }
      },
      "title": "Roles",
      "type": "object"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "series": {
      "discriminator": {
        "mapping": {
          "action": "#/$defs/ActionSeries",
          "attribute": "#/$defs/AttributeSeries"
        },
        "propertyName": "source"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AttributeSeries"
        },
        {
          "$ref": "#/$defs/ActionSeries"
        }
      ],
      "title": "Series"
    },
    "source": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "minItems": 1,
      "title": "Source",
      "type": "array"
    },
    "tested_with": {
      "items": {
        "$ref": "#/$defs/TestedWith"
      },
      "title": "Tested With",
      "type": "array"
    },
    "unverified": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "title": "Unverified",
      "type": "array"
    }
  },
  "required": [
    "id",
    "schema_version",
    "name",
    "source",
    "tested_with",
    "capabilities",
    "kind",
    "forecast_kind",
    "series",
    "resolution_min"
  ],
  "title": "ForecastTemplate",
  "type": "object"
}
