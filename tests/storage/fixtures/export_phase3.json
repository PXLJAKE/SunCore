          "forecast_today": {"entity_id": "sensor.solcast_pv_forecast_forecast_today", "invert_sign": false},
          "forecast_tomorrow": {"entity_id": "sensor.solcast_pv_forecast_forecast_tomorrow", "invert_sign": false}
